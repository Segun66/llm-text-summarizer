APP_ENV=dev
LOG_LEVEL=INFO

# Base64 authorization key from the GigaChat account, without the Basic prefix.
GIGACHAT_CREDENTIALS=
# Full endpoints; required, no URL defaults exist in application code.
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_COMPLETIONS_URL=https://api.giga.chat/v1/chat/completions
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_TIMEOUT_SECONDS=30
GIGACHAT_MAX_ATTEMPTS=3
GIGACHAT_RETRY_MIN_SECONDS=0.5
GIGACHAT_RETRY_MAX_SECONDS=4
GIGACHAT_MAX_TOKENS=512
# Optional PEM CA bundle; system trust store is used when unset.
# GIGACHAT_CA_BUNDLE=C:/certificates/ca-bundle.pem

# Process-local summary cache; TTL in seconds and bounded entry count.
GIGACHAT_CACHE_TTL_SECONDS=300
GIGACHAT_CACHE_MAX_ENTRIES=128
